{
    "name": "slothsoft/chat",
    "description": "A Farah module that renders a simple shoutbox.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=8.2",
        "slothsoft/core": "^1.14.27",
        "slothsoft/farah": "^1.29.2",
        "slothsoft/sse": "^1.11.2"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.13"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Chat\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Chat\\": "tests"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-chat/",
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
